<odoo>
    <!-- Snippet visual editable -->
    <template id="brand_snippet_template" name="Brand Grid">
        <section class="s_brand_grid o_colored_level"
                 data-brand-display="grid"
                 data-brand-columns="4"
                 data-brand-search="true">
            <div class="container">
                <!-- Aquí va tu contenido dinámico -->
                <div class="row brand-grid">
                    <t t-foreach="request.env['product.brand'].search([])" t-as="brand">
                        <div class="brand_item text-center mb-4">
                            <a t-att-href="'/shop/brands?brand=' + str(brand.id)">
                                <img class="img-fluid mb-2"
                                     t-att-src="'/web/image/product.brand/' + str(brand.id) + '/logo'"
                                     t-att-alt="brand.name"/>
                                <h5><t t-esc="brand.name"/></h5>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- Registro en el panel lateral del Website Builder -->
    <template id="snippet_brand_grid" inherit_id="website.snippets" name="Brand Snippet">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <div class="oe_snippet"
                 data-oe-model="ir.ui.view"
                 data-oe-id="website_sale_product_brand.brand_snippet_template">
                <t t-call="website_sale_product_brand.brand_snippet_template"/>
            </div>
        </xpath>
    </template>
</odoo>