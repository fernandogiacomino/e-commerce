<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_brands" name="Brands">
        <t t-call="website.layout">
            <t t-set="additional_title">Product Brands</t>
            <section class="s_brand_grid o_colored_level"
                     data-brand-display="grid"
                     data-brand-columns="4"
                     data-brand-search="true">
                <div class="container">
                    <t t-if="brand_search_enabled">
                        <form action="/page/product_brands"
                              method="post"
                              class="brand-search-form d-flex justify-content-center flex-wrap gap-2 mb-4">
                            <input type="text"
                                   name="search"
                                   class="form-control"
                                   placeholder="Search..."
                                   t-att-value="search"
                                   style="min-width: 200px;" />
                            <button class="btn btn-primary">Search</button>
                            <input type="hidden"
                                   name="csrf_token"
                                   t-att-value="request.csrf_token()" />
                        </form>
                    </t>
                    <t t-if="brand_rec">
                        <div class="row brand-grid">
                            <t t-foreach="brand_rec" t-as="o">
                                <div class="brand_item text-center mb-4">
                                    <a t-att-href="keep('/shop/brands', brand=o.id)">
                                        <img class="img-fluid brand_item_image mb-2"
                                             t-attf-src="/website/image/product.brand/#{o.id}/logo"
                                             t-att-alt="o.name" />
                                        <h5><t t-esc="o.name" /></h5>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="not brand_rec">
                        <div class="text-center text-muted">
                            <h3 class="css_editable_display">No Brands Found.</h3>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

    <template id="categorie_link" inherit_id="website_sale.categorie_link">
        <xpath expr="//a[@t-field='c.name']/.." position="attributes">
            <attribute name="t-att-data-link-href">
                keep('/shop/category/' + slug(c), category=0, brand=brand)
            </attribute>
        </xpath>
    </template>
</odoo>